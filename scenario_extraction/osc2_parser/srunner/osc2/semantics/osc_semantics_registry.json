{
  "meta": {
    "version": "0.1",
    "notes": [
      "This registry captures the actors, actions, and modifiers.",
      "Actions include overloads where applicable (e.g., vehicle.change_lane).",
      "Defaults use literal values or special tokens like '<actor>' for the invoking actor.",
      "Types are opaque strings (e.g., 'length', 'speed'); your type system should interpret them.",
      "Rules include 'mutually_exclusive', 'requires', 'exactly_one_of', and 'at_least_one_of'.",
      "Abstract actions (action families) are marked 'abstract': true and cannot be invoked directly."
    ]
  },
  "enums": {
    "movement_mode": [
      "monotonous",
      "other"
    ],
    "track": [
      "actual",
      "projected"
    ],
    "dynamic_profile": null,
    "lat_measure_by": null,
    "yaw_measure_by": null,
    "orientation_measured_by": null,
    "movement_options": null
  },
  "actor_types": {
    "osc_actor": {
      "inherits": null,
      "fields": {
        "bounding_box": {
          "type": "bounding_box",
          "mandatory": true
        },
        "color": {
          "type": "color",
          "mandatory": false
        },
        "geometry_reference": {
          "type": "string",
          "mandatory": false
        },
        "center_of_gravity": {
          "type": "position_3d",
          "mandatory": true
        },
        "pose": {
          "type": "pose_3d",
          "mandatory": true,
          "var": true
        }
      }
    },
    "physical_object": {
      "inherits": "osc_actor",
      "fields": {}
    },
    "movable_object": {
      "inherits": "physical_object",
      "fields": {
        "velocity": {
          "type": "velocity_6d",
          "mandatory": true,
          "var": true
        },
        "acceleration": {
          "type": "acceleration_6d",
          "mandatory": true,
          "var": true
        },
        "speed": {
          "type": "speed",
          "mandatory": true,
          "var": true
        }
      }
    },
    "traffic_participant": {
      "inherits": "movable_object",
      "fields": {
        "intended_infrastructure": {
          "type": "list<intended_infrastructure>",
          "mandatory": true
        }
      }
    },
    "vehicle": {
      "inherits": "traffic_participant",
      "fields": {
        "vehicle_category": {
          "type": "vehicle_category",
          "mandatory": true
        },
        "rear_overhang": {
          "type": "length",
          "mandatory": true
        }
      }
    },
    "person": {
      "inherits": "traffic_participant",
      "fields": {}
    }
  },
  "actions": {
    "osc_actor.osc_action": {
      "abstract": true,
