          }
        }
      ]
    },
    "vehicle.change_lane": {
      "invoker_type": "vehicle",
      "inherits": "vehicle.action_for_vehicle",
      "overloads": [
        {
          "name": "relative",
          "params": {
            "num_of_lanes": {
              "type": "int",
              "optional": true,
              "default": 1
            },
            "side": {
              "type": "lane_change_side",
              "optional": false
            },
            "reference": {
              "type": "physical_object",
              "optional": true,
              "default": "<actor>"
            },
            "offset": {
              "type": "length",
              "optional": true
            },
            "rate_profile": {
              "type": "dynamic_profile",
              "optional": true
            },
            "rate_peak": {
              "type": "speed",
              "optional": true
            }
          },
          "rules": {
            "requires": [
              [
                "side",
                "num_of_lanes"
              ]
            ]
          }
        },
        {
          "name": "absolute",
          "params": {
            "target": {
              "type": "lane",
              "optional": false
            },
            "offset": {
              "type": "length",
              "optional": true
            },
            "rate_profile": {
              "type": "dynamic_profile",
              "optional": true
            },
            "rate_peak": {
              "type": "speed",
              "optional": true
            }
          }
        }
      ],
      "rules": {
        "overloads_mutually_exclusive": true
      }
    },
